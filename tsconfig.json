{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "*": ["./frontend/node_modules/*"]
    },
    "typeRoots": [
      "./frontend/node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts"
  ],
  "exclude": [
    "frontend",
    "node_modules"
  ]
}
