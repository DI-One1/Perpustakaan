# ==============================================================================
# PERPUSTAKAAN DIGITAL SMK TI BAZMA (BILIK) - ENVIRONMENT VARIABLES
# Salin file ini menjadi .env di root atau di frontend/
# ==============================================================================

# 1. Konfigurasi Database PostgreSQL
# Format: postgres://[user]:[password]@[host]:[port]/[database]?sslmode=disable
DATABASE_URL="postgres://bilik_user:bilik_password@localhost:5432/bilik_db?sslmode=disable"

# Untuk koneksi pooler Supabase mode transaksi (bila memakai hosting Supabase):
# DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepare=false"

# 2. Base URL & Port Aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# 3. Base URL Aset Gambar Statis (Default: /images/)
NEXT_PUBLIC_ASSET_BASE_URL="/images/"

# 4. Kunci Enkripsi Rahasia Sesi (Minimal 32 karakter acak untuk HMAC)
SESSION_SECRET="bilik-smktibazma-super-secret-key-32-chars-long"

# 5. Zona Waktu Sistem (Asia/Jakarta)
TZ="Asia/Jakarta"
