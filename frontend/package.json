{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../docs/02-api/openapi.yaml -o ./src/lib/api/schema.d.ts",
    "check:contrast": "node ../scripts/check-contrast.ts",
    "db:up": "dbmate -d ../infra/db/migrations -s ../infra/db/schema.sql up",
    "db:down": "dbmate -d ../infra/db/migrations -s ../infra/db/schema.sql down",
    "db:seed": "node ../infra/db/seeds/seed.js"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "openapi-fetch": "0.17.0",
    "postgres": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dbmate": "2.38.1",
    "eslint": "9.21.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.3",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
